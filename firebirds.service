[Unit]
Description=Firebirds scoreboard server
After=network-online.target
Wants=network-online.target

[Service]
# Adjust User/WorkingDirectory if you cloned somewhere else.
User=pi
WorkingDirectory=/home/pi/firebirds-scoreboard
ExecStart=/usr/bin/python3 server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
