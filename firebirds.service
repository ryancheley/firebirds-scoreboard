[Unit]
Description=Firebirds scoreboard server
After=network-online.target
Wants=network-online.target

[Service]
# Adjust User/WorkingDirectory to match where you cloned the repo.
User=root
WorkingDirectory=/root/firebirds-scoreboard
ExecStart=/usr/bin/python3 server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
